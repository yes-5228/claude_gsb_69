# Flask 运行环境: development / production / testing
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# 默认使用 SQLite, 无需外部依赖 (留空即使用 backend/instance/air_monitor.db)
# DATABASE_URL=sqlite:///./instance/air_monitor.db
#
# 切换 PostgreSQL: 使用 docker-compose.postgres.yml 覆盖文件, 或手动指定
# DATABASE_URL=postgresql+psycopg2://air:air_pass@db:5432/air_monitor

CORS_ORIGINS=*
TIMEZONE=Asia/Shanghai

# 启动时自动建表 / 写入演示数据
AUTO_INIT_DB=true
AUTO_SEED=true
